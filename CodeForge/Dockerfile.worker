FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/CodeForge.Infrastructure/CodeForge.Infrastructure.csproj src/CodeForge.Infrastructure/
COPY src/CodeForge.Worker/CodeForge.Worker.csproj src/CodeForge.Worker/
RUN dotnet restore src/CodeForge.Worker/CodeForge.Worker.csproj

COPY src/ src/
RUN dotnet publish src/CodeForge.Worker/CodeForge.Worker.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS final

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV DOTNET_CLI_HOME=/tmp/dotnet \
    NUGET_PACKAGES=/tmp/nuget/packages

COPY --from=build --chown=$APP_UID:$APP_UID /app/publish ./
USER $APP_UID

ENTRYPOINT ["dotnet", "CodeForge.Worker.dll"]
