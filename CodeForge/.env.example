DB_HOST=your-postgresql-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=CodeForge
DB_USER=your-database-user
PGPASSWORD=replace-with-your-database-password

QUEUE_CONNECTION_STRING_SEND=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=send-policy;SharedAccessKey=replace-me;EntityPath=your-queue
QUEUE_CONNECTION_STRING_LISTEN=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=listen-policy;SharedAccessKey=replace-me;EntityPath=your-queue
QUEUE_NAME=your-session-enabled-queue

BLOB_SERVICE_URI=https://your-storage-account.blob.core.windows.net/
BLOB_CONTAINER_NAME=reports

# Keep disabled unless submitted repositories are trusted and execution is isolated.
DOTNET_TEST_EXECUTION_ENABLED=false
